# Base config file for Atmel SAME70Q20B ARM processor with USB CDC
# (USB-OTG / USBHS) host link. Used by the renode emulator backend
# in concert with test/emulator/repl/same70_usbhs.cs - the duet3-6hc
# and duet3-6xd printer configs target this firmware variant.
CONFIG_MACH_ATSAM=y
CONFIG_MACH_SAME70Q20B=y
CONFIG_ATSAM_USB=y
