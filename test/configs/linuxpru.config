# Test config for the PRU host-emulation build
#
# Builds src/pru/ against host gcc instead of pru-cgt: pru-specific
# intrinsics, the IEP timer, the PRU INTC, and the four AM335x GPIO
# MMIO blocks are replaced by host-side stubs (src/pru/host_pru.c +
# src/pru/host_inc/), and the pru0 rpmsg shuttle is replaced by a
# pty-based console bridge. The resulting host-arch klipper.elf is
# spawned by scripts/test_klippy.py through the linuxprocess backend
# (linuxpru.dict is dispatched the same way as linuxprocess.dict).
CONFIG_MACH_PRU=y
CONFIG_PRU_HOST_BUILD=y
CONFIG_WANT_BUTTONS=n
CONFIG_WANT_TMCUART=n
CONFIG_WANT_NEOPIXEL=n
CONFIG_WANT_PULSE_COUNTER=n
CONFIG_WANT_HX71X=n
CONFIG_WANT_ST7920=n
CONFIG_WANT_HD44780=n
