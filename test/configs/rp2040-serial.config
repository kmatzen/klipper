# Base config file for Raspberry Pi RP2040 using serial communication on
# UART0 (GPIO0/GPIO1). The 16 KiB bootloader option (FLASH_START_4000)
# skips the boot stage 2 image so the ELF entry point lands directly at
# the application's reset vector and Renode's `sysbus LoadELF` doesn't
# have to execute the SSI flash setup that stage 2 performs on real
# silicon.
CONFIG_MACH_RPXXXX=y
CONFIG_MACH_RP2040=y
CONFIG_RPXXXX_FLASH_START_4000=y
CONFIG_RPXXXX_SERIAL_UART0_PINS_0_1=y
