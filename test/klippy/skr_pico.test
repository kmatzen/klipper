# End-to-end EMULATOR test for the BIGTREETECH SKR Pico v1.0 (RP2040)
# in DETERMINISTIC TICK MODE. Boots klipper firmware under Renode
# against the skr-pico pin map, completes klippy identify + clocksync,
# brings up the full MCU config (4 TMC2209s, 2 software-PWM heaters, 3
# fans, endstops, 2 thermistors), reads the thermistors through the
# RP2040 ADC, round-trips the four TMC2209 register files over the
# shared software UART, and exercises interactive gcode (M114/M105)
# against real firmware.
#
# This is the RP2040 sibling of skr_mini_e3_v2.test (STM32F103) - same
# TMC2209 multi-drop UART pattern (four drivers sharing gpio9/gpio8,
# distinguished by uart_address 0/2/1/3, not a select-pin mux), reusing
# renode_hooks.sw_uart. The reply is always master-addressed (sync=0x05,
# addr=0xff), so every address is served from one shared register file
# and klippy's per-driver IFCNT write-verify lines up (drivers init
# sequentially). DUMP_TMC below reads back the live register file for the
# addr-0 (stepper_x) and addr-3 (extruder) drivers, proving the UART
# read path at both ends of the address range.
#
# Two RP2040-specific harness pieces this exercises:
#   - scripts/test_klippy.py emits sw_uart for the RP2040 "gpioN" pin
#     names (the 'RP' port sentinel); the STM32/SAM path only handled
#     "PXn" names.
#   - renode_hooks.sw_uart drives the firmware-side RX bit by writing the
#     SIO GPIO_IN register (0xD0000004), because RP2040's GPIO is
#     modelled as a plain storeback region, not an IGPIOReceiver.
#
# Thermistors read through test/emulator/rp2040_adc_stub.py: the local
# rp2040.repl models no ADC (the 0x4004C000 region is unmapped), so
# without the stub klipper's thermistor reads never complete and every
# heater reads temp=0.0. The stub drives klipper's RP2040 ADC handshake
# (src/rp2040/adc.c) and serves the fixture's ~36 C readings.
#
# RP2040 keeps time with the Timers.RP2040_Timer peripheral, a
# virtual-time model, so (unlike the STM32F1 DWT) it tracks simulated
# time directly under tick mode with no frequency pin.
#
# The real SKR Pico is USB-only; the RP2040 Renode platform models no
# USB device, so the firmware is the generic serial-mode rp2040 build
# (rp2040.dict, host link uart0 on the board's free gpio0/gpio1) and the
# test exercises the pin map, which is independent of the host link. As
# with duet2_maestro / skr_mini_e3_v2, the gated path is motion-free.
DICTIONARY rp2040.dict
CONFIG skr_pico.cfg
EMULATOR skr_pico.fixture.json
REQUIRES_EMULATOR  # deterministic-time lockstep needs the real backend

# Interactive gcode round-trip against real firmware in tick mode.
M114
M105
# Read back the live TMC register file over the multi-drop UART for the
# lowest and highest addressed drivers. DUMP_TMC reads every register
# (incl. IOIN) live, so it only produces a full dump if the firmware
# round-tripped the read datagrams for that driver's address.
DUMP_TMC STEPPER=stepper_x
DUMP_TMC STEPPER=extruder

# klippy connected, loaded the dictionary, and built the full config
# against real firmware.
EXPECT_LOG_CONTAINS "Loaded MCU 'mcu'"
EXPECT_LOG_CONTAINS "Configured MCU 'mcu'"
# DUMP_TMC dumped both ends of the address range (addr 0 / addr 3); the
# IOIN read returning the TMC2209 version byte (0x21) proves the
# multi-drop UART read path returned framed, CRC-valid responses.
EXPECT_LOG_CONTAINS "DUMP_TMC stepper_x"
EXPECT_LOG_CONTAINS "DUMP_TMC extruder"
EXPECT_LOG_CONTAINS "version=0x21"
# A broken UART round-trip surfaces as a TMC init failure or a direct
# read/write error; the deterministic tick clock must produce neither.
EXPECT_LOG_NOT_CONTAINS "failed to init"
EXPECT_LOG_NOT_CONTAINS "Unable to read tmc uart"
EXPECT_LOG_NOT_CONTAINS "Unable to write tmc uart"
EXPECT_LOG_NOT_CONTAINS "Internal error"
# A renode-side crash (wrong sysbus peripheral, hook callback error)
# kills serial; klippy then gets EOF and TMC init / identify time out.
EXPECT_LOG_NOT_CONTAINS "Got EOF when reading from device"
EXPECT_LOG_NOT_CONTAINS "failed to init: Timeout"
# With the deterministic clock the config / TMC / ADC path pushes no
# deadline into the firmware's past, so nothing shuts down.
EXPECT_LOG_NOT_CONTAINS "ADC out of range"
EXPECT_LOG_NOT_CONTAINS "Timer too close"
EXPECT_LOG_NOT_CONTAINS "Rescheduled timer in the past"
EXPECT_LOG_NOT_CONTAINS "Klippy is shutdown"
